<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="nabeel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:nabeel"
    xmlns:views="clr-namespace:nabeel.views"
    Shell.FlyoutBehavior="Flyout" BackgroundColor="DarkBlue">

    <ShellContent
        Title="الرئيسية"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />    
    <ShellContent
        Title="إرسال سؤال"
        ContentTemplate="{DataTemplate views:QuestionPage}"
        Route="QuestionPage" />    
    <ShellContent
        Title="المنشورات"
        ContentTemplate="{DataTemplate views:PostsPage}"
        Route="PostsPage" />
    <ShellContent
        Title="عن التطبيق"
        ContentTemplate="{DataTemplate views:AboutPage}"
        Route="AboutPage" />

</Shell>
